# Banco de dados PostgreSQL
# Railway: obtenha em railway.app > seu projeto > PostgreSQL > Connect
# Supabase: obtenha em supabase.com > seu projeto > Settings > Database
DATABASE_URL="postgresql://user:password@host:5432/moto_premium?sslmode=require"

# Segredo JWT - gere com: openssl rand -base64 32
JWT_SECRET="seu-segredo-super-seguro-aqui"

# URL do site (necessário para metadados)
NEXT_PUBLIC_URL="https://seu-dominio.vercel.app"
